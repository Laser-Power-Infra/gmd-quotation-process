@@ -0,0 +1,67 @@
+"use server";
+import { loginRequired } from "@/lib/access";
+import { prisma } from "@/lib/prisma";
+
+export type LedgerFollowUpInput = {
+  ledger: string;
+  accCode: string;
+  owner?: string | null;
+  contactName?: string | null;
+  contactPhone?: string | null;
+  contactEmail?: string | null;
+  followUpDate?: string | null; // YYYY-MM-DD
+  promisedDate?: string | null;
+  promisedAmount?: string | number | null;
+  nextActionDate?: string | null;
+  status?: string | null;
+  remarks?: string | null;
+};
+
+/** Appends a follow-up entry for a Debtors/Creditors party; the newest entry is the party's current state. */
+export async function saveLedgerFollowUpAction(input: LedgerFollowUpInput) {
+  const denied = await loginRequired();
+  if (denied) return denied;
+
+  const clean = (v?: string | null) => (v?.trim() ? v.trim() : null);
+  if (input.ledger !== "debtor" && input.ledger !== "creditor") return { success: false as const, error: "Unknown ledger." };
+  const accCode = clean(input.accCode);
+  if (!accCode) return { success: false as const, error: "Party code is required." };
+
+  const dates: Record<string, Date | null> = {};
+  for (const k of ["followUpDate", "promisedDate", "nextActionDate"] as const) {
+    const v = clean(input[k]);
+    if (v && !/^\d{4}-\d{2}-\d{2}$/.test(v)) return { success: false as const, error: `${k} is not a valid date.` };
+    dates[k] = v ? new Date(`${v}T00:00:00Z`) : null;
+    if (dates[k] && Number.isNaN(dates[k]!.getTime())) return { success: false as const, error: `${k} is not a valid date.` };
+  }
+  const amountText = clean(input.promisedAmount == null ? null : String(input.promisedAmount).replace(/,/g, ""));
+  const promisedAmount = amountText === null ? null : Number(amountText);
+  if (promisedAmount !== null && (!Number.isFinite(promisedAmount) || promisedAmount < 0)) {
+    return { success: false as const, error: "Amount must be a positive number." };
+  }
+
+  try {
+    const { auth } = await import("@/auth");
+    const user = (await auth())?.user as { name?: string | null } | undefined;
+    await prisma.ledgerFollowUp.create({
+      data: {
+        ledger: input.ledger,
+        accCode,
+        owner: clean(input.owner),
+        contactName: clean(input.contactName),
+        contactPhone: clean(input.contactPhone),
+        contactEmail: clean(input.contactEmail),
+        followUpDate: dates.followUpDate,
+        promisedDate: dates.promisedDate,
+        promisedAmount,
+        nextActionDate: dates.nextActionDate,
+        status: clean(input.status),
+        remarks: clean(input.remarks),
+        createdBy: user?.name ?? null,
+      },
+    });
+    return { success: true as const };
+  } catch (error) {
+    return { success: false as const, error: error instanceof Error ? error.message : "Save failed." };
+  }
+}
