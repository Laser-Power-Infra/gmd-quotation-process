+/**
+ * Scheduled job — daily Debtors / Creditors refresh.
+ *
+ * Copies these execution-tracking tabs into snapshot tables:
+ *   DEBTORS -> Debtor; SALE BILL / SALE REGISTER / BG -> SaleBill / SaleRegister / BankGuarantee;
+ *   CREDITORS + ADVANCE TO CREDITORS -> Creditor.
+ * Each group is replaced in its own transaction, so a renamed column in one tab fails
+ * that group only and leaves the others' data in place. Follow-ups (LedgerFollowUp)
+ * are never touched. Same mapping helpers as the manual `scripts/sync-debtors*.ts`.
+ */
+
+import { prisma } from "@/lib/prisma";
+import { readSheetTabByGid, readSheetTabByTitleIfPresent, requireColumns } from "@/lib/gmd_lib/bomMastErp";
+import { DEBTORS_GID, mapDebtorRow, resolveDebtorColumns } from "@/lib/debtorsSync";
+import {
+  BG_GID, BG_HEADERS, SALE_BILL_GID, SALE_BILL_HEADERS, SALE_REGISTER_GID, SALE_REGISTER_HEADERS,
+  mapBg, mapSaleBill, mapSaleRegister,
+} from "@/lib/debtorJoinsSync";
+import { ADVANCE_HEADERS, ADVANCES_TAB, CREDITOR_HEADERS, CREDITORS_TAB, mapCreditorAdvance, mapCreditorBill } from "@/lib/creditors";
+import { JobAlreadyRunningError } from "./run-gmd-update";
+
+const CHUNK = 500;
+const JOB = "ledgers";
+let inFlight = false;
+
+type Tab = { tabTitle: string; headers: string[]; rows: string[][] };
+type StepResult = { ok: boolean; written: number; skipped: number; error?: string };
+export type ScheduledLedgersResult = {
+  success: boolean;
+  job: typeof JOB;
+  startedAt: string;
+  elapsedMs: number;
+  steps: Record<"debtors" | "debtorJoins" | "creditors", StepResult>;
+};
+
+function mapRows<T>(tab: Tab, expected: readonly string[], map: (row: string[], c: number[]) => T | null) {
+  const c = requireColumns(tab.headers, [...expected], tab.tabTitle);
+  const out: T[] = [];
+  let skipped = 0;
+  for (const row of tab.rows) {
+    try {
+      const rec = map(row, c);
+      if (rec) out.push(rec);
+      else skipped++;
+    } catch {
+      skipped++;
+    }
+  }
+  return { out, skipped };
+}
+
+const chunks = <T>(a: T[]) => Array.from({ length: Math.ceil(a.length / CHUNK) }, (_, i) => a.slice(i * CHUNK, (i + 1) * CHUNK));
+
+async function byTitle(id: string, title: string): Promise<Tab> {
+  const t = await readSheetTabByTitleIfPresent(id, title);
+  if (!t) throw new Error(`No tab titled "${title}" in the execution-tracking workbook`);
+  return { tabTitle: title, ...t };
+}
+
+async function step(name: string, fn: () => Promise<{ written: number; skipped: number }>): Promise<StepResult> {
+  try {
+    const r = await fn();
+    console.log(`[scheduler] ${JOB}/${name}: written=${r.written} skipped=${r.skipped}`);
+    return { ok: true, ...r };
+  } catch (err) {
+    const error = err instanceof Error ? err.message : String(err);
+    console.error(`[scheduler] ${JOB}/${name} failed: ${error}`);
+    return { ok: false, written: 0, skipped: 0, error };
+  }
+}
+
+export async function runScheduledLedgers(): Promise<ScheduledLedgersResult> {
+  if (inFlight) throw new JobAlreadyRunningError(JOB);
+  inFlight = true;
+  const startedAtMs = Date.now();
+  try {
+    const id = process.env.GMD_EXECUTION_TRACKING_SPREADSHEET_ID;
+    if (!id) throw new Error("GMD_EXECUTION_TRACKING_SPREADSHEET_ID is not set");
+
+    const debtors = await step("debtors", async () => {
+      const tab = await readSheetTabByGid(id, DEBTORS_GID);
+      const idx = resolveDebtorColumns(tab.headers, tab.tabTitle);
+      const results = tab.rows.map((r) => mapDebtorRow(r, idx));
+      const data = results.flatMap((r) => (r.ok ? [r.record] : []));
+      await prisma.$transaction([prisma.debtor.deleteMany(), ...chunks(data).map((d) => prisma.debtor.createMany({ data: d }))]);
+      return { written: data.length, skipped: results.length - data.length };
+    });
+
+    const debtorJoins = await step("debtorJoins", async () => {
+      const bills = mapRows(await readSheetTabByGid(id, SALE_BILL_GID), SALE_BILL_HEADERS, mapSaleBill);
+      const regs = mapRows(await readSheetTabByGid(id, SALE_REGISTER_GID), SALE_REGISTER_HEADERS, mapSaleRegister);
+      const bgs = mapRows(await readSheetTabByGid(id, BG_GID), BG_HEADERS, mapBg);
+      await prisma.$transaction([
+        prisma.saleBill.deleteMany(),
+        prisma.saleRegister.deleteMany(),
+        prisma.bankGuarantee.deleteMany(),
+        ...chunks(bills.out).map((data) => prisma.saleBill.createMany({ data })),
+        ...chunks(regs.out).map((data) => prisma.saleRegister.createMany({ data })),
+        ...chunks(bgs.out).map((data) => prisma.bankGuarantee.createMany({ data })),
+      ]);
+      return { written: bills.out.length + regs.out.length + bgs.out.length, skipped: bills.skipped + regs.skipped + bgs.skipped };
+    });
+
+    const creditors = await step("creditors", async () => {
+      const bills = mapRows(await byTitle(id, CREDITORS_TAB), CREDITOR_HEADERS, mapCreditorBill);
+      const advances = mapRows(await byTitle(id, ADVANCES_TAB), ADVANCE_HEADERS, mapCreditorAdvance);
+      const data = [...bills.out, ...advances.out];
+      await prisma.$transaction([prisma.creditor.deleteMany(), ...chunks(data).map((d) => prisma.creditor.createMany({ data: d }))]);
+      return { written: data.length, skipped: bills.skipped + advances.skipped };
+    });
+
+    const steps = { debtors, debtorJoins, creditors };
+    return {
+      success: Object.values(steps).every((s) => s.ok),
+      job: JOB,
+      startedAt: new Date(startedAtMs).toISOString(),
+      elapsedMs: Date.now() - startedAtMs,
+      steps,
+    };
+  } finally {
+    inFlight = false;
+  }
+}
