@@ -1205,3 +1205,45 @@ model BankGuarantee {
 
   @@index([beneficiaryName])
 }
+
+/// CREDITORS (kind "bill", amount = UN_ALLOC_CR) and ADVANCE TO CREDITORS
+/// (kind "advance", amount = UN_ALLOC_DR) rows; snapshot replaced by the daily ledgers sync.
+model Creditor {
+  id            String    @id @default(cuid())
+  kind          String
+  accSch        String?
+  accCode       String
+  accName       String?
+  vrNo          String?
+  vrDate        DateTime?
+  dueDate       DateTime?
+  amount        Decimal?  @db.Decimal(18, 2)
+  partyBillNo   String?
+  partyBillDate DateTime?
+  particular    String?
+  syncedAt      DateTime  @default(now())
+
+  @@index([accCode])
+}
+
+/// Append-only follow-up log for the Debtors / Creditors pages. The newest row per
+/// (ledger, accCode) is the current state; older rows are the history. Never touched by the sheet sync.
+model LedgerFollowUp {
+  id             String    @id @default(cuid())
+  ledger         String // "debtor" | "creditor"
+  accCode        String
+  owner          String?
+  contactName    String?
+  contactPhone   String?
+  contactEmail   String?
+  followUpDate   DateTime?
+  promisedDate   DateTime?
+  promisedAmount Decimal?  @db.Decimal(18, 2)
+  nextActionDate DateTime?
+  status         String?
+  remarks        String?
+  createdBy      String?
+  createdAt      DateTime  @default(now())
+
+  @@index([ledger, accCode, createdAt])
+}
