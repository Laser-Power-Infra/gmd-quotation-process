+import { getFollowUps, toIso, toNum } from "@/lib/debtors-server";
+
+/**
+ * Creditors in the Debtors row shape so the same ageing/summary code serves both:
+ * a bill's amount owed is the "due" (unAllocDr), an unadjusted advance is the "credit" (unAllocCr).
+ * Bills with no DUEDATE age from VRDATE.
+ */
+export async function getCreditors(): Promise<DebtorsResult> {
+  const [records, names, followUps] = await Promise.all([
+    prisma.creditor.findMany({ orderBy: [{ accCode: "asc" }, { vrDate: "asc" }] }),
+    prisma.accMaster.findMany({ select: { accCode: true, accName: true } }),
+    getFollowUps("creditor"),
+  ]);
+  const nameOf = new Map(names.map((n) => [followUpKey(n.accCode), n.accName]));
+
+  const agedFromVrDate: string[] = [];
+  const rows: DebtorRow[] = records.map((r) => {
+    const amount = toNum(r.amount);
+    const bill = r.kind === "bill";
+    if (bill && !r.dueDate && r.vrDate) agedFromVrDate.push(r.id);
+    return {
+      id: r.id,
+      accSch: r.accSch,
+      accCode: r.accCode,
+      accName: r.accName ?? nameOf.get(followUpKey(r.accCode)) ?? null,
+      tCode: r.kind,
+      vrNo: r.vrNo,
+      vrDate: toIso(r.vrDate),
+      dueDate: toIso(bill ? (r.dueDate ?? r.vrDate) : r.dueDate),
+      particular: r.particular,
+      drAmt: amount,
+      drAllocAmt: null,
+      unAllocDr: bill ? amount : null,
+      unAllocCr: bill ? null : amount,
+      partyBillNo: r.partyBillNo,
+      partyBillDate: toIso(r.partyBillDate),
+    };
+  });
+
+  const latest = records.reduce<Date | null>((a, r) => (a === null || r.syncedAt > a ? r.syncedAt : a), null);
+  return {
+    rows,
+    totals: computeDebtorTotals(rows),
+    syncedAt: latest ? latest.toISOString() : null,
+    billInfo: {},
+    bgs: [],
+    followUps,
+    agedFromVrDate,
+  };
+}
