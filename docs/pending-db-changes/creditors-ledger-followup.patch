+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { creditorGroup, mapCreditorAdvance, mapCreditorBill } from '../lib/creditors.js'
+
+test('creditor bill and advance rows map amounts and dates', () => {
+  const bill = mapCreditorBill(['G', 'C1', 'Acme', 'PB1', '01-10-2026', '', '1,000.50', 'B9', '30-09-2026'], [0, 1, 2, 3, 4, 5, 6, 7, 8])!
+  assert.equal(bill.kind, 'bill')
+  assert.equal(bill.amount, 1000.5)
+  assert.equal(bill.dueDate, null)
+  assert.equal(bill.vrDate?.toISOString().slice(0, 10), '2026-10-01')
+  const adv = mapCreditorAdvance(['G', 'C1', 'BP1', '02-10-2026', '500', '', '', 'adv'], [0, 1, 2, 3, 4, 5, 6, 7])!
+  assert.equal(adv.kind, 'advance')
+  assert.equal(adv.amount, 500)
+  assert.equal(mapCreditorBill(['G', '', 'x'], [0, 1, 2, 3, 4, 5, 6, 7, 8]), null)
+  assert.throws(() => mapCreditorBill(['G', 'C1', 'x', '', '', '', 'abc', '', ''], [0, 1, 2, 3, 4, 5, 6, 7, 8]))
+})
+
+test('creditor grouping keeps customs, labour and importers apart', () => {
+  assert.equal(creditorGroup('COMMISSIONER OF CUSTOMS'), 'Customs')
+  assert.equal(creditorGroup('Ram Labour Contractor'), 'Labour')
+  assert.equal(creditorGroup('Tianjin Tangfa Valve Co'), 'Import')
+  assert.equal(creditorGroup('Shree Castings Pvt Ltd'), 'Local vendors')
+})
