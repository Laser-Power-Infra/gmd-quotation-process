model LookupOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type, isActive])
}

model GeneratedImage {
  id            String    @id @default(cuid())
  itemType      String?
  operationType String?
  rmType        String?
  imageKey      String    @unique
  url           String?
  driveFileId   String?
  prompt        String?
  promptVersion String    @default("v1")
  model         String?
  status        String    @default("pending") // pending | generating | ready | failed
  error         String?
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([itemType])
  @@index([operationType])
  @@index([rmType])
  @@index([status])
}

model DocketQuotationThread {
  id            Int       @id @default(autoincrement())
  mysqlThreadId Int?      @map("mysql_thread_id")
  threadId      String    @unique @map("thread_id") @db.VarChar(255)
  mailType      String    @map("mail_type") @db.VarChar(50)
  docketNo      String?   @map("docket_no") @db.VarChar(255)
  docketStatus  String?   @map("docket_status") @db.VarChar(100)
  state         String?   @db.VarChar(100)
  isGmdClient   Boolean   @default(false) @map("is_gmd_client")
  isReplied     Boolean   @default(false) @map("is_replied")
  actionTag     String?   @map("action_tag") @db.VarChar(100)
  matchReasons  String?   @map("match_reasons")
  date          DateTime? @db.Timestamptz(6)
  sender        String?   @db.VarChar(500)
  senderDetails Json?     @map("sender_details")
  toDetails     Json?     @map("to_details")
  ccDetails     Json?     @map("cc_details")
  subject       String?
  body          String?
  bodyPreview   String?   @map("body_preview")
  attachNames   Json?     @map("attach_names")
  attachLinks   Json?     @map("attach_links")
  ocrText       String?   @map("ocr_text")
  aiSummary     String?   @map("ai_summary")
  category      String?   @db.VarChar(100)
  subCategory   String?   @map("sub_category") @db.VarChar(100)
  company       String?   @db.VarChar(100)
  codeword      String?   @db.VarChar(100)
  userLabels    Json?     @map("user_labels")
  pendingDocket Boolean?
  partyName     String?
  msgCount      Int       @default(1) @map("msg_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([threadId], map: "idx_dqt_thread_id")
  @@index([docketNo], map: "idx_dqt_docket_no")
  @@index([docketStatus], map: "idx_dqt_docket_status")
  @@index([isGmdClient], map: "idx_dqt_is_gmd_client")
  @@index([actionTag], map: "idx_dqt_action_tag")
  @@index([mailType], map: "idx_dqt_mail_type")
  @@index([date(sort: Desc)], map: "idx_dqt_date")
  @@index([company], map: "idx_dqt_company")
  @@map("docket_quotation_threads")
}

model PbgData {
  id            BigInt    @id @default(autoincrement())
  clientName    String?   @map("client_name")
  project       String?
  poNumber      String?   @map("po_number")
  poDate        DateTime? @map("po_date") @db.Date
  bgNo          String?   @map("bg_no")
  bgDate        DateTime? @map("bg_date") @db.Date
  bgAmtFc       Decimal?  @map("bg_amt_fc") @db.Decimal(18, 2)
  expiryDate    DateTime? @map("expiry_date") @db.Date
  claimDate     DateTime? @map("claim_date") @db.Date
  marginPct     Decimal?  @map("margin_pct") @db.Decimal(8, 2)
  marginAmount  Decimal?  @map("margin_amount") @db.Decimal(18, 2)
  contactPerson String?   @map("contact_person")
  contactNumber String?   @map("contact_number")
  remark        String?
  status        String?
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("pbg_data")
}

// ─────────────────────────────────────────────────────────────
// Engineering Data ("GMD Technical Master Data"). Synced from the sheet by
// lib/technical/syncEngineering.ts and read back by
// lib/technical/engineeringData.ts (these tables -> the UI). The read path
// never talks to Google; only the sync does.
//
// Every value column is String? rather than a number/date so the sheet's own
// formatting survives verbatim ("2.0", "PN - 10", "IS 6392 TABLE 13"). Column
// order is declared in lib/technical/engineeringModels.ts and must stay in step
// with the tab's captions in lib/technical/tableConfig.ts.
// ─────────────────────────────────────────────────────────────

/// "GATE VALVE" — gid 531982553
model GateValve {
  id                        String   @id @default(cuid())
  rowIndex                  Int
  sizeMm                    String?
  pnRatingClass             String?
  diaOfBonnetMin            String?
  diaOfBonnetMax            String?
  heightOfBonnetMm          String?
  faceToFaceLengthMm        String?
  faceToFaceLengthTolerance String?
  flangeOdMm                String?
  flangeOdTolerance         String?
  pcdMm                     String?
  pcdTolerance              String?
  numberOfBolts             String?
  boltDiameterMm            String?
  source                    String?
  material                  String?
  bodyPressure              String?
  durationBody              String?
  seatPressure              String?
  durationSeat              String?
  approxWeightKg            String?
  syncedAt                  DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([syncedAt])
  @@map("gate_valve")
}

/// "FLANGE" — gid 0
