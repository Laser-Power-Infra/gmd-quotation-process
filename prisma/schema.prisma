generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Enquiry {
  id               String   @id @default(cuid())

  docketNumber     String   @unique
  partyName        String
  enquiryDate      DateTime

  enquiryType      String?
  state            String?
  paymentTerms     String?
  inspection       String?
  pbg              String?
  utility          String?
  vaPercent        Float?
  orderStatus      String?
  closureStatus    String?
  projectReference String?

  attachments      Attachment[]
  items            EnquiryItem[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Attachment {
  id          String   @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  name        String
  url         String
  type        String?
  size        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EnquiryItem {
  id            String   @id @default(cuid())

  enquiryId     String
  enquiry       Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  itemName      String
  quantity      Decimal

  itemType      String?
  moc           String?
  itemTypeSource String?
  mocSource      String?
  size          String?
  pnRating      String?
  erpItemCode   String?
  operationType String?
  extension     String?
  bypass        String?
  productCost   Decimal?
  costRefCode   String?
  cost          Decimal?
  stockStatus   String?
  discount      Decimal?
  vaPercent     String?
  quotedRate    String?
  bomId         String?
  bomType       String? //(stores "DIRECT M2M")
  rmItemCode    String? //(the CONSUMPTION-1 rm code, for traceability)
  contractReviewRate String?
  pdcostValidation  String?
  quotedRateGst String?
  itemNameMerge String?
  totalValue   String?
  deliverySchedule String?
  itemWiseTotalValue String?
  itemStatus     String?
  position  Int      @default(0)
  validation String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model GmdItemCode {
  id          String   @id @default(cuid())
  itemCode    String   // "Code for The Item" column
  itemType    String   // ITEM TYPE (col 19)
  moc         String   // MOC (col 20)
  operation   String   // OPERATION (col 21)
  size        String   // SIZE (col 22)
  pnGmd       String   // PN-GMD (col 24)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([itemType, moc, operation, size, pnGmd])
}
model ExtensionCost {
  id        String   @id @default(cuid())
  length    String    @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BypassCost {
  id        String   @id @default(cuid())
  size      String   @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentTermsCost {
  id        String   @id @default(cuid())
  terms     String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model InspectionCost {
  id        String   @id @default(cuid())
  type      String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PbgCost {
  id        String   @id @default(cuid())
  pbg       String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TransportationCost {
  id        String   @id @default(cuid())
  state     String   @unique
  fullLoad  String
  partLoad  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplyHistoryItem {
  id              String   @id @default(cuid())
  financialYear   String?
  partyName       String?
  erpPartyName    String?
  itemName        String
  invoiceNo       String
  date            String?
  partyOrderNo    String?
  partyDate       String?
  quantity        String?
  uom             String?
  value           String?
  grossTotalInvoiceValue String?
  lrNoDt          String?
  deliveryDestination    String?
  consigneeAddress       String?
  consigneeName          String?
  erpContractNo   String?
  erpItemCode     String?
  typeOfValve     String?
  sizeOfValve     String?
  classOfValve    String?
  sparesType      String?
  moc             String?
  orderCopy       String?
  invoice         String?
  inspectionReport String?
  state           String?
  utility         String?
  performanceCertificate String?
  servicePeriodComplete   String?
  warrantyValidTillAsPerContract String?
  warrantyValidNot String?
  bgNo            String?
  pbgValidTill    String?
  asPerOrderWarrantyPeriod String?
  pbgClaimTill    String?
  pbgAmount       String?
  warrantyExpDateAsPerInv   String?
  partyMailAddress String?
  orderList       String?
  derivedItemType String?
  derivedMoc      String?
  derivedSize     String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([invoiceNo, itemName])
}

model GMDUpdateItem {
  id              String   @id @default(cuid())
  erpItemCode     String?
  itemNameAuto    String?
  l1              String?
  l2ValveType     String?
  l3Dia           String?
  l7Dimension     String?
  l4Component     String?
  l5Material      String?
  l6Std           String?
  l8ItemCategory  String?
  um              String?
  conv1           String?
  pcsWgt          String?
  aum             String?
  availableStock  String?
  cost            String?
  usdRateOption   String?
  hsnCode         String?
  hsnCodeValidation String?
  conv2           String?
  majorMarking    String?
  newItemStatus   String?
  currentStatus   String?
  rmType          String?
  indianImported  String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContractReview {
  id                     String   @id @default(cuid())
  contractNo             String
  itemCode               String
  mcNo                   String?
  itemName               String?
  partyItemName          String?
  rate                   String?
  cv                     String?
  vaPercent              String?
  orderQty               String?
  freeStock              String?
  finalReq               String?
  mcQty                  String?
  balanceMc              String?
  prodOrdQty             String?
  balanceToProdOrd       String?
  balanceToProdEnt       String?
  diQty                  String?
  billedQty              String?
  balBillAgMc            String?
  balBillAgCont          String?
  item                   String?
  value                  String?
  size                   String?
  pnRating               String?
  dateOfContract         String?
  clearanceStatus        String?
  actuator               String?
  rmCodeForActuator      String?
  rmCodeForGb            String?
  paymentTerms           String?
  lcRtgsRefNo            String?
  lcDateRtgsDate         String?
  lastDateOfShipmentDateOfLc String?
  issuingBankName        String?
  bomFormulaTrial        String?
  erpPartyNameFromGmdSupplyHistory String?
  itemType               String?
  jobCode                String?
  balDiQty               String?
  balMcVal               String?
  balProdOrdVal          String?
  balToProdOrdEntVal     String?
  balBillAgMcVal         String?
  balBillAgContVal       String?
  balDiVal               String?
  diVal                  String?
  icQty                  String?
  syncedAt               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([itemCode, contractNo])
}

model VerifyBom {
  id         String   @id @default(cuid())
  bomId      String
  itemCode   String
  rmItemCode String
  bomIdType  String?
  bomItemQty String?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bomId, itemCode, rmItemCode])
}
model LookupOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([type, value])
  @@index([type, isActive])
}