generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Enquiry {
  id               String   @id @default(cuid())

  docketNumber     String   @unique
  partyName        String
  enquiryDate      DateTime

  enquiryType      String?
  state            String?
  paymentTerms     String?
  inspection       String?
  pbg              String?
  utility          String?
  vaPercent        Float?
  orderStatus      String?
  closureStatus    String?

  attachments      Attachment[]
  items            EnquiryItem[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Attachment {
  id          String   @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  name        String
  url         String
  type        String?
  size        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EnquiryItem {
  id            String   @id @default(cuid())

  enquiryId     String
  enquiry       Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  itemName      String
  quantity      Decimal

  itemType      String?
  moc           String?
  itemTypeSource String?
  mocSource      String?
  size          String?
  pnRating      String?
  operationType String?
  extension     String?
  bypass        String?
  productCost   Decimal?
  costRefCode   String?
  cost          Decimal?
  stockStatus   String?
  discount      Decimal?
  vaPercent     String?
  quotedRate    String?
  quotedRateGst String?
  itemNameMerge String?
  totalValue   String?
  deliverySchedule String?
  itemWiseTotalValue String?
  position  Int      @default(0)
  validation String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model ExtensionCost {
  id        String   @id @default(cuid())
  length    String    @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BypassCost {
  id        String   @id @default(cuid())
  size      String   @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentTermsCost {
  id        String   @id @default(cuid())
  terms     String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model InspectionCost {
  id        String   @id @default(cuid())
  type      String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PbgCost {
  id        String   @id @default(cuid())
  pbg       String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TransportationCost {
  id        String   @id @default(cuid())
  state     String   @unique
  fullLoad  String
  partLoad  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplyHistoryItem {
  id              String   @id @default(cuid())
  financialYear   String?
  partyName       String?
  erpPartyName    String?
  itemName        String
  invoiceNo       String
  date            String?
  partyOrderNo    String?
  partyDate       String?
  quantity        String?
  uom             String?
  value           String?
  grossTotalInvoiceValue String?
  lrNoDt          String?
  deliveryDestination    String?
  consigneeAddress       String?
  consigneeName          String?
  erpContractNo   String?
  erpItemCode     String?
  typeOfValve     String?
  sizeOfValve     String?
  classOfValve    String?
  sparesType      String?
  moc             String?
  orderCopy       String?
  invoice         String?
  inspectionReport String?
  state           String?
  utility         String?
  performanceCertificate String?
  servicePeriodComplete   String?
  warrantyValidTillAsPerContract String?
  warrantyValidNot String?
  bgNo            String?
  pbgValidTill    String?
  asPerOrderWarrantyPeriod String?
  pbgClaimTill    String?
  pbgAmount       String?
  warrantyExpDateAsPerInv   String?
  partyMailAddress String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([invoiceNo, itemName])
}

model GMDUpdateItem {
  id              String   @id @default(cuid())
  erpItemCode     String?
  itemNameAuto    String?
  l1              String?
  l2ValveType     String?
  l3Dia           String?
  l7Dimension     String?
  l4Component     String?
  l5Material      String?
  l6Std           String?
  l8ItemCategory  String?
  um              String?
  conv1           String?
  pcsWgt          String?
  aum             String?
  availableStock  String?
  cost            String?
  usdRateOption   String?
  hsnCode         String?
  hsnCodeValidation String?
  conv2           String?
  majorMarking    String?
  newItemStatus   String?
  currentStatus   String?
  rmType          String?
  indianImported  String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}