  rowIndex               Int
  typeOfValve            String?
  sizeOfValve            String?
  pnRating               String?
  torqueOfValve          String?
  torqueWithSafetyFactor String?
  turnsToCloseValves     String?
  std                    String?
  pcd                    String?
  shaftLength            String?
  shaftDiaStemDia        String?
  sizeOfBase             String?
  boreDia                String?
  drillingDimension      String?
  gearBoxType            String?
  nmReqdRange            String?
  rmCode                 String?
  approved               String?
  reqdBase               String?
  gearboxSerialNoEmerson String?
  gearboxSerialNoViral   String?
  gearBoxOutputTorque    String?
  turnsToClose           String?
  mechAdvantage          String?
  ratio                  String?
  maxDriveBore           String?
  weight                 String?
  recommendedHandwheelMm String?
  gearboxPriceEmerson    String?
  gearboxViral           String?
  actuatorModelNo        String?
  actuatorRpm            String?
  syncedAt               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([syncedAt])
  @@map("gear_box")
}

/// "ACUATOR-MODEL NO" — gid 962975923
model Actuator {
  id                 String   @id @default(cuid())
  rowIndex           Int
  model              String?
  speed              String?
  ratedTq            String?
  size               String?
  poles              String?
  lrtCurrentInA      String?
  ratedTqCurrentInA  String?
  avgLoadCurrentInA  String?
  nominalKw          String?
  powerFactor        String?
  efficiency         String?
  olrSet             String?
  withInchingDuty    String?
  withoutInchingDuty String?
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([syncedAt])
  @@map("actuator")
}

/// "DENSITY" — gid 166133048. Hidden from the subtab bar but still synced, so
/// the material -> density values are available to the other tabs.
model Density {
  id           String   @id @default(cuid())
  rowIndex     Int
  material     String   @unique
  densityGmCm3 String?
  syncedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([syncedAt])
  @@map("density")
}

/// Sync bookkeeping — one row per tab. Its absence is what marks a tab as
/// "never synced", which the read API reports to the UI.
model EngineeringSync {
  tabKey    String   @id
  syncedAt  DateTime @default(now())
  totalRows Int

  @@map("engineering_sync")
}
