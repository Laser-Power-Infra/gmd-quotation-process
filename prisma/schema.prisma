  boltLengthMm                      String?
  boltDiaMm                         String?
  boltWeightCsKg                    String?
  boltWeightSsKg                    String?
  boltWeightAsKg                    String?
  syncedAt                          DateTime @default(now())
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@index([syncedAt])
  @@map("flange")
}

/// "GEAR BOX" — gid 1266518282
model GearBox {
