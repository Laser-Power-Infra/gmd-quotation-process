model BisStatus {
  id                String    @id @default(cuid())
  itemName          String?
  bisNo             String    @unique
  expiryDate        DateTime?
  applicationStatus String?
  remark            String?
  reachedLab        String?
  licenseNo         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IndentListing {
  id                 String   @id @default(cuid())
  item               String?
  size               String?
  pnRating           String?
  mcReceivedPending  String? // "Received" | "Pending"
  totalBalBillAgCont Float? // summed BAL BILL AG CONT
  v1                 String?
