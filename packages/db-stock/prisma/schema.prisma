// Stock database. Holds the PhysicalStock table and this app's login `User`
// accounts (isolated from @gmd/db-quotation users).
//
// The physical stock page reads/writes through `src/index.ts`; the local
// Postgres `PhysicalStock` table is left in place but goes stale. Keep this
// model in lock-step with `@gmd/db-quotation` (`model PhysicalStock`).
//
//   pnpm --filter @gmd/db-stock db:migrate
//   pnpm --filter @gmd/db-stock db:generate

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model PhysicalStock {
  id                             String   @id @default(cuid())
  erp_code                       String?
  location                       String?
  l2_valve_type                  String?
  dimension                      String?
  l7_dimension                   String?
  l4_component                   String?
  l5_material                    String?
  l6_std                         String?
  l8_item_category               String?
  received_qty                   String?
  dispatch_qty                   String?
  available_qty                  String?
  remarks                        String?
  sum_of_physical_stock          String?
  stock_as_per_erp               String?
  rate_unit                      String?
  rate_per_pc_qty_weight         String?
  weight_per_pc                  String?
  item_wise_value                String?
  moving_within_3_months         String?
  order_ag_approval_recvd        String?
  purchase_in_26_27              String?
  dispatched_in_26_27            String?
  order_in_hand_qty              String?
  shortage_qty                   String?
  unnamed_aa                     String?
  item_type                      String?
  price                          String?
  moq                            String?
  if_less_than_moq_extra_charges String?
  drawing_technical_data         String?
  // Derived from the FullItem/RawMaterial BOM relations (which live in the
  // LOCAL database). `cost` is the highest owning FullItem.cost, falling back
  // to the RawMaterial.cost. `bom_id` is the BOM carrying that highest cost.
  cost                           String?
  bom_id                         String?
  // Derived from RawMaterial.majorMarking by erpItemCode match: true = major
  // ('true'), false = minor ('false'), null when no RawMaterial matches.
  majorminor_marking             Boolean?
    form_date                           DateTime @default(now())
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt
  // Set from the mobile heat-entry form once every heat of this row is entered.
  heat_done                      Boolean  @default(false)
  heat_entries                   HeatEntry[]

  @@index([erp_code])
}

// One heat (and so one serial) of a PhysicalStock row; a row can have many.
// Serial number = erp_code-l8_item_category-heat_no-heat_seq. heat_no is typed
// by the user; heat_seq counts up per heat_no across all rows (serial_no is
// built in listPhysicalStock, not stored).
model HeatEntry {
  id                String        @id @default(cuid())
  physical_stock_id String
  physical_stock    PhysicalStock @relation(fields: [physical_stock_id], references: [id], onDelete: Cascade)
  heat_no           String
  heat_seq          Int
  // Google Drive file id of the printed serial sheet; null = serial reserved, sheet not yet uploaded.
  sheet_file_id     String?
  created_at        DateTime      @default(now())

  @@unique([heat_no, heat_seq])
  @@index([physical_stock_id])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  password      String // bcrypt hash
  role          String        @default("user") // "user" | "admin" | "developer"
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// One line of a purchase order, mirrored from the `PURCHASE ORD AND GRN` tab of
// the GMD EXECUTION TRACKING workbook (see `docs/purchase-in-transit.md`).
//
// `balanceQty` is the sheet's own BALANCE column: what is ordered but not yet
// received against a GRN — the in-transit quantity. `salesContract` (SALES_CONT)
// is what ties that quantity back to the sales order it was bought for.
//
// Strings, like PhysicalStock, because the cells are not clean enough to trust
// a numeric column; `lib/inTransit.ts` parses on read.
model PurchaseOrderLine {
  id            String   @id @default(cuid())
  poNo          String // VRNO
  poLineNo      String // SLNO
  poDate        String? // VRDATE, dd-MMM-yyyy
  itemCode      String? // ITEM_CODE -> PhysicalStock.erp_code
  itemName      String?
  supplierCode  String? // ACC_CODE
  supplierName  String? // ACC_NAME
  uom           String? // UM
  altUom        String? // AUM
  netQtyOrder   String? // NET_QTYORDER
  qtyExecuted   String? // QTYEXECUTE
  balanceQty    String? // BALANCE — in transit
  rate          String?
  basicAmount   String? // BASIC_AMT
  exchangeRate  String? // EXCHANGE_RATE
  deliverySched String? // DELIVERY_SCH
  grnDate       String? // GRN_VRDATE
  salesContract String? // SALES_CONT
  partyRefNo    String? // PARTYREFNO
  partyRefDate  String? // PARTYREFDATE
  lastPoRate    String? // LAST_PO_RATE
  minPoRate     String? // MIN_PO_RATE — lowest rate this item was ever bought at
  lastPoDate    String? // LAST_PO_DATE

  // Derived by the sync with `@gmd/purchase/in-transit`, so every filter and
  // total is one Prisma query instead of parsing 13k strings per request.
  // `inTransit` is BALANCE (floored at 0), falling back to ordered - received;
  // `lineValue` is BASIC_AMT parsed. Both null when the cells are unparseable.
  inTransit     Float?
  lineValue     Float?

  syncedAt      DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([poNo, poLineNo])
  @@index([itemCode])
  @@index([salesContract])
  @@index([inTransit])
}

// One receipt line of the `GRN` tab (GMD EXECUTION TRACKING). Joined to the PO
// line it was received against on (orderVrNo, orderSlNo) = (poNo, poLineNo).
// The tab has no unique key, so the sync replaces the whole table each run.
model GrnLine {
  id            String   @id @default(cuid())
  mainPostName  String? // MAIN_POST_NAME
  accCode       String? // ACC_CODE (supplier)
  vrNo          String // VRNO — GRN number
  vrDate        String? // VRDATE
  itemCode      String? // ITEM_CODE
  partyBillNo   String? // PARTYBILLNO
  partyBillDate String? // PARTYBILLDATE
  orderVrNo     String? // ORDER_VRNO -> PurchaseOrderLine.poNo
  orderSlNo     String? // ORDER_SLNO -> PurchaseOrderLine.poLineNo
  qtyRecd       Float? // QTYRECD
  purValue      Float? // PUR_VALUE
  syncedAt      DateTime @default(now())

  @@index([orderVrNo, orderSlNo])
}
