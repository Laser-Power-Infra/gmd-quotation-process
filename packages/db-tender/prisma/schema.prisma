  @@index([tenderStatusId])
  @@index([utilityMappingId])
  @@map("tender_merged")
}

model EmdDetailsBG {
  id                 String    @id @db.VarChar(100)
  trantype           String?
  bankName           String?
  partyCode          String?
  partyName          String?
  staffName          String?
  bgNo               String?
  bgDate             String?
  bgAmtLocal         String?
  bgAmtFc            String?
  expiryDate         String?
  claimDate          String?
  remark             String?
  status             String?
  remarks            String?
  contactNo          String?
  contactEmailId     String?
  address            String?
  tenderNo1          String?
  tenderNo           String?
  tenderNo2          String?
  match              String?
  bgMatch            String?
  statusPriceAssDone String?
  tmNo               String?
  docketNo           String?
  lastEmailSent      String?
  emailDraft         String?   @db.Text
  lastEmailSentAt    DateTime?
  reason             String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmdDetailsCash {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerName                     String?
  issueDt                          DateTime?
  emdAmt                           String?
  permanent                        String?
  tenderNo                         String?
