# =============================================================================
# Tender Executive Dashboard - environment template
# Copy to .env and fill in values. Never commit real secrets.
#
# Tags:
#   [REQUIRED]            app fails (or is insecure) without it
#   [REQUIRED for <X>]    only feature X breaks when unset
#   [OPTIONAL]            safe fallback exists (default noted)
# =============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
# [REQUIRED] Tender PostgreSQL DB (@gmd/db-tender, seed). ContractReview lives here.
TENDER_DATABASE_URL="postgresql://user:password@localhost:5432/tender_dashboard"

# [REQUIRED] Auth.js session secret. Generate with: npx auth secret
AUTH_SECRET=""

# [REQUIRED for AI analysis / PDF extraction]
OPENAI_API_KEY=""

# [REQUIRED in production] Must be "PROD" or outbound n8n / WhatsApp / notification sends are skipped
ENVIRONMENT="DEV"

# [REQUIRED] API key for /api/external and internal calls. Hardcoded fallback is insecure - always set.
EXTERNAL_API_KEY="change-me"

# [REQUIRED] File encryption. KEY = 32 chars, IV = 16 chars. Hardcoded fallbacks are insecure - always set.
FILE_CRYPTO_KEY="00000000000000000000000000000000"
FILE_CRYPTO_IV="0000000000000000"

# [REQUIRED] Automation pipeline version: "v1" (tender:tasks / tender:parsing) or "v2" (automation-v2:tasks / automation-v2:parsing).
# Every tender task / parsing publish (including costing/CVA parsing) throws when unset or invalid.
AUTOMATION_VERSION="v1"

# [OPTIONAL] RabbitMQ connection. Queue publishing disabled when unset.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# [REQUIRED] Tender automation / agent client IDs
TENDER_AUTOMATION_PARSING_CLIENT_ID=""
TENDER_AUTOMATION_AUTOMATION_CLIENT_ID=""
TENDER_AGENT_INTELLIGENCE_CLIENT_ID=""
TENDER_AGENT_RELEVANCE_CLIENT_ID=""
TENDER_AGENT_FEEDBACK_CLIENT_ID=""
TENDER_AGENT_INGESTION_CLIENT_ID=""

# [OPTIONAL] Chrome/Chromium executable for PDF generation and GeM downloaders. Auto-detected when unset.
CHROME_PATH=""

# ----------------------------------------------------------------------------
# Google service account (Drive / Sheets)
# Private keys: wrap in quotes, keep literal \n line breaks.
# ----------------------------------------------------------------------------
# [REQUIRED for Google Drive / Sheets] Set GOOGLE_SERVICE_ACCOUNT_EMAIL or GOOGLE_CLIENT_EMAIL (either one)
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# [REQUIRED for sheets sync / contract attachments / Drive name resolution]
GDRIVE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# [REQUIRED for sheets sync] Target Google Spreadsheet ID
GOOGLE_SPREADSHEET_ID=""

# ----------------------------------------------------------------------------
# Smartsheet
# ----------------------------------------------------------------------------
# [REQUIRED for Smartsheet sync]
SMARTSHEET_API_TOKEN=""
# [REQUIRED for organization sync]
SMARTSHEET_SHEET_ID=""
# [REQUIRED for LC (letter of credit) sync]
LC_SMARTSHEET_ID=""
# [REQUIRED for costing sync] Sales enquiry item list sheet ID
SALES_ENQUIRY_ITEM_LIST_ERP_ID=""

# ----------------------------------------------------------------------------
# Network file paths (UNC shares)
# ----------------------------------------------------------------------------
# [REQUIRED for tender attachments / document indexer]
INDEXER_NETWORK_PATH="\\\\server\\share\\tenders"
# [REQUIRED for costing file attachments]
COSTING_FILE_NETWORK_PATH="\\\\server\\share\\costing"
# [REQUIRED for supply documents / supply indexer]
SUPPLY_NETWORK_PATH="\\\\server\\share\\supply"
# [REQUIRED for conductor files]
CONDUTOR_PATH="\\\\server\\share\\conductor"
# [REQUIRED for old tender / BOQ files]
OLD_FILES="\\\\server\\share\\old-files"
# [REQUIRED for type test files / ledger]
TYPE_TEST_FILES_PATH="\\\\server\\share\\type-test"
# [OPTIONAL] Old reverse auction Excel folder. Falls back to root path / INDEXER_NETWORK_PATH.
OLD_RA_EXCEL_PATH=""

# ----------------------------------------------------------------------------
# n8n webhooks
# ----------------------------------------------------------------------------
# [REQUIRED for tender webhook] Production and test URLs
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_URL_TEST=""
# [REQUIRED for notifications]
N8N_NOTIFICATION_WEBHOOK_URL=""
# [REQUIRED for EMD flow]
N8N_EMD_WEBHOOK_URL=""
# [REQUIRED for reverse auction flow]
N8N_RA_WEBHOOK_URL=""
# [REQUIRED for requisition emails]
REQUISITION_EMAIL_N8N_WEBHOOK_URL=""
# [REQUIRED for certificate emails] Set either; EMAIL variant takes precedence
N8N_CERTIFICATE_EMAIL_WEBHOOK_URL=""
N8N_CERTIFICATE_WEBHOOK_URL=""

# ----------------------------------------------------------------------------
# Evolution API (WhatsApp)
# ----------------------------------------------------------------------------
# [REQUIRED for WhatsApp messages]
EVOLUTION_API_KEY=""
# [OPTIONAL] default: http://evolution-api:8080
EVOLUTION_API_BASE_URL="http://evolution-api:8080"
# [OPTIONAL] Instance name. Has hardcoded default.
EVOLUTION_API_INSTANCE=""
# [REQUIRED for respective notification routes] Recipient number / group JID
EVOLUTION_RESULT_NOTIFICATION_NUMBER=""
EVOLUTION_REASON_NOT_PROVIDED_NOTIFICATION_NUMBER=""
EVOLUTION_CATALOGUE_MISSING_NOTIFICATION_NUMBER=""
EVOLUTION_NOT_PARTICIPATED_NOTIFICATION_NUMBER=""

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
# [OPTIONAL] BOM item-schedule API. Default: internal http://192.168.1.190:4555/api/item-schedule/by-name
BOM_API_URL=""
# [OPTIONAL] BOM API key
BOM_API_KEY=""
# [OPTIONAL] Monitoring alert recipient. Default: tender-alerts@laserpower.co.in
MONITOR_ALERT_EMAIL=""

# ----------------------------------------------------------------------------
# Contract Review drawings (@gmd/contract-review, S3-compatible storage)
# Bucket CORS must allow PUT from this app's origin (browser uploads directly).
# ----------------------------------------------------------------------------
# [REQUIRED for Contract Review drawings]
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
# [OPTIONAL] default: us-east-1
S3_REGION="us-east-1"

# ----------------------------------------------------------------------------
# Feature flags (Flags SDK)
# ----------------------------------------------------------------------------
# [OPTIONAL] Enables Flags Explorer overrides in the Vercel Toolbar and the
# /.well-known/vercel/flags endpoint. 32 random bytes, base64url, different per
# environment. Flags still work (with their code values) when unset.
FLAGS_SECRET=""
