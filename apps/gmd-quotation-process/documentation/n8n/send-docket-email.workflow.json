      "parameters": {
        "operation": "reply",
        "messageId": "={{ $json.messageId }}",
        "message": "={{ $json.body.html }}",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "attachment"
              }
            ]
          },
          "ccList": "={{ $json.body.cc }}"
        }
      },
      "id": "gmail-reply",
      "name": "Reply",
      "type": "n8n-nodes-base.gmail",
