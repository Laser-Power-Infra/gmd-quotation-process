      }
    },
    {
      "parameters": {
        "jsCode": "// Reply path failed: restore the original webhook body + attachment binary\n// so 'Send a message' still has $json.body.* and $binary.attachment.\nconst webhook = $('Webhook').first();\nreturn [{ json: webhook.json, binary: webhook.binary }];"
      },
