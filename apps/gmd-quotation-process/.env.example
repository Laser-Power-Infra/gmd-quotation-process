# =============================================================================
# GMD Quotation Process - environment template
# Copy to .env (local) / .env.production (Docker) and fill in values.
# Never commit real secrets.
#
# Tags:
#   [REQUIRED]            app fails (or is insecure) without it
#   [REQUIRED for <X>]    only feature X breaks when unset
#   [OPTIONAL]            safe fallback exists (default noted)
#
# =============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
# [REQUIRED] Quotation PostgreSQL DB (@gmd/db-quotation)
QUOTATION_DATABASE_URL="postgresql://user:password@localhost:5432/gmd-quotation"

# [REQUIRED] Tender PostgreSQL DB (@gmd/db-tender). ContractReview lives here.
TENDER_DATABASE_URL="postgresql://user:password@localhost:5432/tender_dashboard"

# [REQUIRED for the Physical Stock page] Stock PostgreSQL DB (@gmd/db-stock). PhysicalStock lives here.
STOCK_DATABASE_URL="postgresql://user:password@localhost:5432/gmd-stock"

# [REQUIRED] Auth.js session secret. Generate with: npx auth secret
AUTH_SECRET=""

# [REQUIRED for /api/scheduler/* routes] API key the scheduler sends to trigger jobs
GMD_SYNC_API_KEY=""

# [REQUIRED in production] Must be "PROD" or WhatsApp (Evolution API) sends are skipped
ENVIRONMENT="DEV"

# ----------------------------------------------------------------------------
# Google Sheets (sync sources)
# ----------------------------------------------------------------------------
# [REQUIRED for Contract Review sync] CONTRACTS + DUMP spreadsheet
CONTRACT_REVIEW_SPREADSHEET_ID=""
# [REQUIRED for Supply History sync]
SUPPLY_HISTORY_SPREADSHEET_ID=""
# [REQUIRED for BOM sync] VERIFY BOM spreadsheet
BOM_SHEET_SPREADSHEET_ID=""
# [REQUIRED for RM AVAIL / stock sync] stock-phys spreadsheet
GOOGLE_SPREADSHEET_ID=""
# [REQUIRED for contract order links]
CONTRACT_SHEET_SPREADSHEET_ID=""
# [OPTIONAL] GMD Clientwise ORDER LIST source. Default: built-in spreadsheet ID
GMD_CLIENTWISE_SPREADSHEET_ID=""
# [OPTIONAL] Listed on the Data Sources page; only needed for the related scripts
CR_CONTRACT_DUMP_SPREADSHEET_ID=""
SALE_BILL_SPREADSHEET_ID=""
# [REQUIRED for Technical / Engineering Data sync]
TECHNICAL_SHEET_SPREADSHEET_ID=""
# [OPTIONAL] Physical Stock sync source. Default: GOOGLE_SPREADSHEET_ID
STOCK_PHYSICAL_SHEET_ID=""
# [OPTIONAL] PBG sync source. Default: built-in spreadsheet ID and tab gid
PBG_SHEET_ID=""
PBG_SHEET_GID=""
# [OPTIONAL] PBG tab name, used only if the gid lookup fails. Default: TEST SHEET
PBG_SHEET_TAB=""

# ----------------------------------------------------------------------------
# Google OAuth (env only; credentials.json / token.json are no longer read)
# ----------------------------------------------------------------------------
# [REQUIRED] All three must be set; every Google Sheets / Drive feature fails without them.
GOOGLE_CLIENT_ID="625599805176-kh24olggl4q1rbcjktvp94digvl6vfd9.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# ----------------------------------------------------------------------------
# S3-compatible storage (attachments, Contract Review drawings)
# Bucket CORS must allow PUT from this app's origin (drawings upload directly).
# ----------------------------------------------------------------------------
# [REQUIRED for attachments / drawings]
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
# [OPTIONAL] default: us-east-1
S3_REGION="us-east-1"

# ----------------------------------------------------------------------------
# AI
# ----------------------------------------------------------------------------
# [REQUIRED for chat, AI validation and image generation]
OPENAI_API_KEY=""
# [OPTIONAL] Set to "false" to skip AI validation. Default: enabled
AI_VALIDATION_ENABLED="true"
# [OPTIONAL] Set to "true" to let docket item extraction fall back to AI. Default: off
AI_FALLBACK_ENABLED="false"
# [OPTIONAL] Model for that fallback. Default: gpt-6-luna
AI_EXTRACTION_MODEL="gpt-6-luna"

# --- Pending Dockets AI verification (dedicated key/quota) ---
# [REQUIRED for Pending Dockets AI verification] Dedicated key used only for
# verifying whether a mail is a genuine new-docket request. Leave empty to show
# candidates as "Not verified" without calling the model. Set later in deployment.
DOCKET_AI_API_KEY=""
# [OPTIONAL] Set to "false" to disable docket AI verification. Default: enabled
DOCKET_AI_VALIDATION_ENABLED="true"
# [OPTIONAL] Model for docket verification. Default: gpt-6-luna
DOCKET_AI_MODEL="gpt-6-luna"
# [OPTIONAL] Max model calls per thread (true/false is final). Default: 3
DOCKET_AI_MAX_ATTEMPTS=3
# [OPTIONAL] Max threads verified per scheduler run. Default: 25
DOCKET_AI_MAX_PER_RUN=25
# [OPTIONAL] Max threads verified per pending-dockets page request. Default: 25
DOCKET_AI_MAX_PER_REQUEST=25
# [OPTIONAL] Pending Dockets response cache TTL in ms. Default: 10000
PENDING_DOCKETS_CACHE_TTL_MS=10000
# [OPTIONAL] Input truncation limits (characters).
DOCKET_AI_MAX_SUBJECT_CHARS=500
DOCKET_AI_MAX_BODY_CHARS=6000
DOCKET_AI_MAX_OCR_CHARS=4000

# ----------------------------------------------------------------------------
# Integrations
# ----------------------------------------------------------------------------
# [REQUIRED for n8n webhook calls]
N8N_WEBHOOK_URL=""
# [REQUIRED for sending docket emails] n8n workflow in documentation/n8n
N8N_DOCKET_WEBHOOK_URL=""
# [REQUIRED for the 24-hour technical-evaluation follow-up] same folder, separate workflow
N8N_TECH_EVAL_FOLLOWUP_WEBHOOK_URL=""
# [REQUIRED for ERP item update / reopen emails] "[GMD]Update Erp Item" n8n webhook
N8N_ERP_ITEM_WEBHOOK_URL=""
# [REQUIRED for WhatsApp messages]
EVOLUTION_API_KEY=""
# [OPTIONAL] default: http://evolution-api:8080
EVOLUTION_API_BASE_URL="http://evolution-api:8080"
# [OPTIONAL] Instance name. Has hardcoded default.
EVOLUTION_API_INSTANCE=""

# ----------------------------------------------------------------------------
# Feature flags (Flags SDK)
# ----------------------------------------------------------------------------
# [OPTIONAL] Enables Flags Explorer overrides in the Vercel Toolbar and the
# /.well-known/vercel/flags endpoint. 32 random bytes, base64url, different per
# environment. Flags still work (with their code values) when unset.
FLAGS_SECRET=""
